# Template only — never put real credentials in this file, it is committed.
# Copy to .env.local (gitignored) and fill it in there.

# MongoDB connection string used to store checkout orders.
# Local mongod:
#   MONGODB_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name (optional, defaults to "alkhayr").
MONGODB_DB=alkhayr

# Public base URL of the site, used to build the order-details link
# (https://<SITE_URL>/order/<orderNumber>) sent on WhatsApp.
SITE_URL=

# Meta WhatsApp Cloud API — sends a "view order" link to the customer and to
# every owner number as soon as an order is placed. See
# developers.facebook.com/docs/whatsapp. This sends a pre-approved message
# template, not a free-form message — order notifications are
# business-initiated, and Meta only delivers free-form/interactive messages
# to a recipient within 24 hours of them messaging the business number
# first, which can't be relied on here.
#
# WHATSAPP_ACCESS_TOKEN: a permanent token from a System User with the
#   whatsapp_business_messaging permission (Meta Business Settings).
# WHATSAPP_PHONE_NUMBER_ID: the "Phone number ID" of your WhatsApp sender,
#   from the app's WhatsApp > API Setup page.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Name/language of the approved message template used for order
# notifications. The template needs one body variable (the order number)
# and a dynamic URL button pointing at `${SITE_URL}/order/{{1}}`.
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANG=ar

# Store-owner numbers (E.164, comma-separated) that get the same order
# notification as the customer
WHATSAPP_OWNER_NUMBERS=