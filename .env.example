# Template only — never put real credentials in this file, it is committed.
# Copy to .env.local (gitignored) and fill it in there.

# MongoDB connection string used to store checkout orders.
# Local mongod:
#   MONGODB_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name (optional, defaults to "alkhayr").
MONGODB_DB=alkhayr
